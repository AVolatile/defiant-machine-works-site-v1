# HTTPS endpoint accepting JSON. Configure on the server only.
FORM_ENDPOINT=
# Optional authorization token for your chosen form delivery endpoint.
FORM_ENDPOINT_TOKEN=
NEXT_PUBLIC_SITE_URL=https://defiantmachineworks.com

# No live payment adapter is enabled. Both flags are required for test orders.
COMMERCE_MODE=disabled
PAYMENT_PROVIDER=disabled
# Local test-only storage. Production requires a shared durable repository adapter.
ORDER_DATABASE_PATH=.data/orders.sqlite
# Optional private test-order key: 32 random bytes encoded as 64 hex characters.
ORDER_ENCRYPTION_KEY=
